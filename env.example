TICKETMIND_APP_NAME=TicketMind
TICKETMIND_ENVIRONMENT=development
TICKETMIND_LOG_LEVEL=INFO
TICKETMIND_DATABASE_URL=postgresql+psycopg://ticketmind_app:replace_me@localhost:5432/ticketmind_dev

# 北京地域业务空间；填入自己的真实配置，不要提交 .env
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
TICKETMIND_MODEL=qwen3.7-flash
# historical_cases_v1 固定使用该模型的 1024 维向量
TICKETMIND_EMBEDDING_MODEL=text-embedding-v4

TICKETMIND_MILVUS_URI=http://127.0.0.1:19530
TICKETMIND_MILVUS_TIMEOUT_SECONDS=10

# 每个角色使用独立本地身份，至少 32 个非空白 ASCII 字符；不要共享给多人
# 可运行 scripts/configure_local_auth.py 生成，不会打印或替换已有凭据
TICKETMIND_OPERATOR_ID=operator
TICKETMIND_REVIEWER_ID=reviewer
TICKETMIND_OPERATOR_TOKEN=
TICKETMIND_REVIEWER_TOKEN=

TICKETMIND_AGENT_VERSION=ticketmind-m3
# dense / bm25 / hybrid；先迁移并执行 knowledge.py seed/reconcile
TICKETMIND_RETRIEVAL_MODE=dense
TICKETMIND_RETRIEVAL_TOP_K=3
TICKETMIND_RETRIEVAL_CANDIDATE_K=20
TICKETMIND_RETRIEVAL_RRF_K=60
TICKETMIND_PROCESSING_TIMEOUT_SECONDS=90
TICKETMIND_MAX_SEARCH_ROUNDS=2
TICKETMIND_MAX_CASE_DETAILS=2
TICKETMIND_MAX_AGENT_STEPS=8
TICKETMIND_MAX_CLARIFICATION_ROUNDS=2
# 正式 runtime 只读 PostgreSQL；生产知识与固定合成评测隔离
TICKETMIND_KNOWLEDGE_DATASET=production-v1
# 仅 seed / evaluation 使用，默认项目内 data/synthetic/v2/historical_cases.jsonl
# TICKETMIND_CORPUS_PATH=
